{
  "compilerOptions": {
    "noImplicitAny": true,
    "module": "ESNext",
    "target": "esnext",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "paths": {
      "*": [
        "./src/*"
      ]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "include": [
    "./config/jest/setupTests.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ],
  "exclude": [
    ".fttemplates/*"
  ]
}